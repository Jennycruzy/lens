# Creditcoin CC3 testnet (deployment target)
CC3_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network

# Source chains attested by CC3 testnet
ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Archive access for differential testing (Alchemy free tier is sufficient)
ETHEREUM_ARCHIVE_RPC=

# Proof builder, primary then failover
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
PROOF_BUILDER_FALLBACK_URL=https://proof-gen-api.cc3-testnet.creditcoin.network

# Prober keys. Never commit a filled .env.
PROBER_PRIVATE_KEY=
CC3_PRIVATE_KEY=

# Deployed contracts
LENS_REGISTRY=
LENS_PROBE=
LENS_AGGREGATOR_ETHUSD=
LENS_VOTE_TOKEN=
